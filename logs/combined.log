stener('mousedown', handleClickOutside);\r\n    };\r\n  }, [isOpen]);\r\n\r\n  const scroll = (id) =>{\r\n\r\n     setTimeout(() => {\r\n         const element = document.getElementById(id);\r\n         if (element) {\r\n             element.scrollIntoView({ behavior: 'smooth' });\r\n         }\r\n     }, 100);\r\n\r\n  }\r\n\r\nreturn (\r\n  <div className='screen'>\r\n    {!dashboard && (\r\n        <div className='navBar'>\r\n          <div className='navMain'>\r\n            <div className='mainnavunder'>\r\n              <Link to='/' className='logoB'>\r\n                <img src={ai} className='navLogo' alt='logo'/>\r\n              </Link>\r\n              <p>Claudify</p>\r\n            </div>\r\n            <Link to='/dashboard' onClick={() => setDashboard(true)} className='textButton'>Workspace</Link>\r\n          </div>\r\n          <div className='navLinks'>\r\n            <a \r\n              href='#features' \r\n              onClick={(e) => {\r\n                  e.preventDefault();\r\n                  navigate('/');\r\n                  scroll(\"features\");\r\n              }} \r\n              className='textButton invisiblebutton'\r\n          >\r\n                        Features\r\n          </a>\r\n           <a \r\n              href='#subscriptions' \r\n              onClick={(e) => {\r\n                  e.preventDefault();\r\n                  navigate('/');\r\n                  scroll('subscriptions');\r\n              }} \r\n              className='textButton invisiblebutton'\r\n          >\r\n            Subscriptions\r\n          </a>\r\n          <a \r\n              href='#subscriptions' \r\n              onClick={(e) => {\r\n                  e.preventDefault();\r\n                  navigate('/');\r\n                  scroll('faq');\r\n              }} \r\n              className='textButton invisiblebutton'\r\n          >\r\n            FAQ\r\n          </a>\r\n            {!isLogedIn && (\r\n                <button type='button' h
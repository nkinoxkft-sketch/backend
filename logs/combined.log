w-item-wrapper {\r\n  display: flex;\r\n  align-items: center;\r\n  background-color: #2a2a2a; /* A sötét beviteli mezőhöz illeszkedő háttér */\r\n  border: 1px solid #3f3f46; /* Finom, sötétszürke keret */\r\n  border-radius: 12px;\r\n  padding: 6px 10px 6px 12px;\r\n  width: fit-content;\r\n  color: #e4e4e7;\r\n  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\r\n  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);\r\n  transition: border-color 0.2s ease;\r\n}\r\n\r\n.preview-item-wrapper:hover {\r\n  border-color: #52525b; /* Kicsit kivilágosodik a keret, ha ráviszed az egeret */\r\n}\r\n\r\n/* Maga a tartalom (kép vagy dokumentum) elrendezése */\r\n.preview-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n\r\n/* Kép előnézet formázása */\r\n.image-preview img {\r\n  width: 36px;\r\n  height: 36px;\r\n  object-fit: cover;\r\n  border-radius: 6px;\r\n  background-color: #1a1a1a;\r\n}\r\n\r\n/* Dokumentum ikon (📄) mérete */\r\n.doc-preview .file-icon {\r\n  font-size: 1.2rem;\r\n  color: #a1a1aa;\r\n}\r\n\r\n/* Fájl nevének és méretének elrendezése (egymás alatt) */\r\n.file-info {\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n}\r\n\r\n/* Fájlnév: hosszú név esetén pontokkal rövidítve (ellipsis) */\r\n.file-name {\r\n  font-size: 0.85rem;\r\n  font-weight: 500;\r\n  max-width: 60px; /* Szükség szerint növelhető */\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  color: #ffffff;\r\n}\r\n\r\n/* Fájlméret stílusa */\r\n.file-size {\r\n  font-size: 0.7rem;\r\n  color: #888888;\r\n  margin-top: 2px;\r\n}\r\n\r\n/* Törlés gomb (X) formázása */\r\n.remove-file-btn {\r\n  background: transparent;\r\n  border: none;\r\n  color: #888888;\r\n  cursor: pointer;\r\n  font-size: 1rem;\r\n  margin-left: 8px;\r\n  padding: 4px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  border-radius: 50%;\r\n  transition: all 0.2s ease;\r\n  line-height: 1
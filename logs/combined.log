\n.gemini-textarea:hover::-webkit-scrollbar-thumb {\r\n  background: #4b5563; /* Diszkrét szürke szín */\r\n}\r\n\r\n.gemini-textarea:hover::-webkit-scrollbar-track {\r\n  background: transparent;\r\n}\r\n\r\n/* Placeholder megjelenítése üres állapotban */\r\n.gemini-textarea:empty:before {\r\n  content: attr(data-placeholder);\r\n  color: #757575;\r\n  pointer-events: none;\r\n  display: block;\r\n}\r\n\r\n/* A legördülő menü konténere */\r\n.chat-options-container {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n/* A trigger ikon (plusz gomb) */\r\n.trigger-icon {\r\n  cursor: pointer;\r\n  width: 24px;\r\n  height: 24px;\r\n  opacity: 0.8;\r\n  transition: opacity 0.15s ease, transform 0.15s ease;\r\n  color: #e3e3e3;\r\n\r\n}\r\n\r\n.trigger-icon:hover {\r\n  opacity: 1;\r\n}\r\n\r\n/* A felugró opciók doboza */\r\n.options-popup {\r\n  position: absolute;\r\n  bottom: calc(100% + 12px);\r\n  left: 0;\r\n  width: 320px;\r\n  background-color: #1e1e1e;\r\n  border-radius: 16px;\r\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);\r\n  padding: 16px;\r\n  z-index: 1000;\r\n  border: 1px solid rgba(255, 255, 255, 0.08);\r\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\r\n  animation: fadeIn 0.15s ease-out;\r\n}\r\n\r\n/* Fájlfeltöltő sáv */\r\n.file-upload-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 10px 12px;\r\n  background-color: rgba(255, 255, 255, 0.04);\r\n  border-radius: 10px;\r\n  cursor: pointer;\r\n  margin-bottom: 12px;\r\n  transition: background-color 0.15s;\r\n}\r\n\r\n.file-upload-row:hover {\r\n  background-color: rgba(255, 255, 255, 0.08);\r\n}\r\n\r\n.file-upload-label {\r\n  font-size: 18px;\r\n  cursor: pointer;\r\n}\r\n\r\n/* Címkék szövegei */\r\n.option-label-text {\r\n  color: #e3e3e3;\r\n  font-size: 14px;\r\n  margin: 0;\r\n  font-weight: 500;\r\n}\r\n\r\n/* Textarea szekció */\r\n.textarea-wrapper {\r\n  display: 